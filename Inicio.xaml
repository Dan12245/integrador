<UserControl x:Class="C.R.A_Consumo_reducido_de_agua.Inicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:gif ="http://wpfanimatedgif.codeplex.com"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:C.R.A_Consumo_reducido_de_agua"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF04023E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#FF7385E3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="15">
                            <!-- 🔸 Redondeo de esquinas -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7385E3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="SaltoStoryboard">
            <DoubleAnimation
            Storyboard.TargetName="btnSaltoTransform"
            Storyboard.TargetProperty="Y"
            From="0" To="-10" Duration="0:0:0.1"
            AutoReverse="True"
            RepeatBehavior="2x"/>
        </Storyboard>
    </UserControl.Resources>

    <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="Login_Window" Background="#FF86A5FF" Height="434" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle HorizontalAlignment="Left" Height="434" Stroke="#FF394D7E" VerticalAlignment="Center" Width="98" Fill="#FF394D7E"/>
            <Image Source="/Captura de pantalla 2025-10-08 132404.png" Stretch="Fill" Margin="-848,0,848,0"/>
            <Button x:Name="Boton_Configuracion" Content="" Click="Boton_ir_a_Configuracion" HorizontalAlignment="Left" Margin="20,174,0,0" VerticalAlignment="Top" BorderBrush="#FF7385E3" FontSize="36" Width="58" Height="56" RenderTransformOrigin="0,0">

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FFBBD3F8" Opacity="1"/>
                </Button.Background>
            </Button>
            <Button x:Name="Boton_Reportar" Content="" Click="Boton_Reporte" HorizontalAlignment="Left" Margin="20,368,0,0" VerticalAlignment="Top" BorderBrush="#FF7385E3" FontSize="36" Width="58" Height="56" RenderTransformOrigin="0,0">

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FFBBD3F8" Opacity="1"/>
                </Button.Background>
            </Button>
            <Image Margin="21,10,723,374" Source="/logo programa.png" Stretch="Fill" />
            <Rectangle HorizontalAlignment="Left" Height="2" Margin="98,75,0,0" Stroke="#FF212B69" VerticalAlignment="Top" Width="702"/>
            <Button x:Name="Boton_Usuario" Content="" Click="Boton_Usuario_Invitados" HorizontalAlignment="Left" Margin="20,274,0,0" VerticalAlignment="Top" BorderBrush="#FF7385E3" FontSize="36" Width="58" Height="56" RenderTransformOrigin="0,0">

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FFBBD3F8" Opacity="1"/>
                </Button.Background>
            </Button>
            <Button x:Name="Boton_Menu" Content="" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#FF303C73" FontSize="36" Width="58" Height="56" RenderTransformOrigin="0,0" Margin="49,69,0,0" BorderThickness="100">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="44.78"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FFBBD3F8" Opacity="1"/>
                </Button.Background>
            </Button>
            <Image Margin="32,378,734,20" Source="/Reportar.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Image Margin="30,284,730,114" Source="/Usuario e invitados.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Image Margin="28,182,730,212" Source="/Configuracion.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Image Margin="26,90,726,307" Source="/Menu Principal seleccionado.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Image Margin="130,14,32,374" Source="/Texto Inicio.png" Stretch="Fill"/>
            <Rectangle HorizontalAlignment="Left" Height="335" Margin="113,89,0,0" VerticalAlignment="Top" Width="677" Fill="#FFCBDAFF" RadiusX="31.5" RadiusY="31.5">
                <Rectangle.Stroke>
                    <SolidColorBrush Color="Black" Opacity="0"/>
                </Rectangle.Stroke>
            </Rectangle>
            <TextBlock x:Name="Texto_Bienvenida" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" MaxWidth="321" Margin="121,102,0,0" FontSize="28" Width="321" LineStackingStrategy="BlockLineHeight" TextTrimming="WordEllipsis" FontFamily="Cascadia Code SemiLight" TextAlignment="Center"><Run Language="es-mx" Text="Esto no deberia salir, en caso de que si, reportar"/></TextBlock>
            <TextBlock x:Name="Texto_Porcentaje" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" MaxWidth="321" Margin="121,216,0,0" FontSize="20" Width="321" LineStackingStrategy="BlockLineHeight" TextTrimming="WordEllipsis" FontFamily="Cascadia Code SemiLight" TextAlignment="Center"><Run Text="Este mensaje no deberia salir, en caso de que si, "/><Run Text="dani 2 no hizo su jale"/><Run Text=" o el visual"/><Run Language="es-mx" Text=" ya"/><Run Text=" valio verga"/></TextBlock>
            <ComboBox HorizontalAlignment="Left" Margin="476,98,0,0" VerticalAlignment="Top" Width="292" SelectionChanged="ComboBox_SelectionChanged" BorderBrush="#FF86A5FF" Foreground="#FF53669E" Background="#FF86A5FF">
                <ComboBoxItem Content="domicilio 1"/>
            </ComboBox>
            <Border BorderBrush="Black" BorderThickness="1" Margin="476,125,32,191"/>
            <TextBlock x:Name="Texto_Fecha" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" MaxWidth="321" Margin="476,247,0,0" FontSize="16" Width="294" LineStackingStrategy="BlockLineHeight" TextTrimming="WordEllipsis" FontFamily="Cascadia Code SemiLight" TextAlignment="Center"><Run Text="Aca deberia haber una grafica, "/><Run Language="es-mx" Text="con fechas "/><Run Text="pero pos a lo mejor y vale verga tambien xd"/></TextBlock>
            <Button HorizontalAlignment="Left" Margin="722,357,0,0" VerticalAlignment="Top" Background="{x:Null}" BorderBrush="{x:Null}" Height="67" Width="68" Click="btnSalto_Click">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="btnSaltoTransform" Y="0"/>
                </Button.RenderTransform>
                <Image gif:ImageBehavior.AnimatedSource="/teto-tetoris.gif"/>
            </Button>
            <Button Content="Button" Click ="btnSiguiente_Click" HorizontalAlignment="Left" Margin="729,291,0,0" VerticalAlignment="Top" Height="36" Width="54">
                <Button.Foreground>
                    <ImageBrush/>
                </Button.Foreground>
                <Button.BorderBrush>
                    <SolidColorBrush Color="#FF7385E3" Opacity="0"/>
                </Button.BorderBrush>
                <Button.Background>
                    <ImageBrush ImageSource="/flecha.png"/>
                </Button.Background>
            </Button>
            <Button Content="" Click="btnAnterior_Click" HorizontalAlignment="Left" Margin="130,291,0,0" VerticalAlignment="Top" Height="36" Width="54" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-179.517"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Foreground>
                    <ImageBrush/>
                </Button.Foreground>
                <Button.BorderBrush>
                    <SolidColorBrush Color="#FF7385E3" Opacity="0"/>
                </Button.BorderBrush>
                <Button.Background>
                    <ImageBrush ImageSource="/flecha.png"/>
                </Button.Background>
            </Button>
            <TextBlock x:Name="texto_consejo" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" MaxWidth="527" Margin="197,293,0,0" FontSize="16" Width="527" LineStackingStrategy="BlockLineHeight" TextTrimming="WordEllipsis" FontFamily="Cascadia Code SemiLight" TextAlignment="Center"><Run Language="es-mx" Text="Consejos consejosamente consejosos"/></TextBlock>
            <Image Margin="410,347,307,10" Source="/perrito chivas.png" Stretch="Fill"/>
            <TextBlock x:Name="texto_modo" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" MaxWidth="224" Margin="498,405,0,0" FontSize="16" Width="219" LineStackingStrategy="BlockLineHeight" TextTrimming="WordEllipsis" FontFamily="Cascadia Code SemiLight" TextAlignment="Center"><Run Language="es-mx" Text="Modo sexo :diablo:"/></TextBlock>

        </Grid>
    </Viewbox>
</UserControl>
