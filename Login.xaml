<UserControl x:Class="C.R.A_Consumo_reducido_de_agua.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:C.R.A_Consumo_reducido_de_agua"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF04023E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#FF7385E3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="15">
                            <!-- 🔸 Redondeo de esquinas -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7385E3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="Login_Window" Background="#FFB2CFE6" Height="434" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Image Margin="-187,48,547,-53" Source="/descarga.png" Stretch="Fill"/>
            <Image x:Name="MareaImage" Margin="-76,343,-182,-146" Source="/Marea.png" Stretch="Fill"/>

            <Rectangle Height="426" Width="392" UseLayoutRounding="True" HorizontalAlignment="Center" VerticalAlignment="Center" RadiusX="26.535" RadiusY="26.535">
                <Rectangle.Stroke>
                    <SolidColorBrush Color="Black" Opacity="0"/>
                </Rectangle.Stroke>
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.6">
                        <GradientStop Color="#FF8BA6BF"/>
                        <GradientStop Color="#FF3757A9" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Button x:Name="Boton_Register" Content="Register" Click="Boton_Register_Click" HorizontalAlignment="Left" Margin="387,87,0,0" VerticalAlignment="Top" FontSize="16" Width="155" Height="35" RenderTransformOrigin="0,0">
                <Button.BorderBrush>
                    <SolidColorBrush Color="#FF04023E" Opacity="0.6"/>
                </Button.BorderBrush>

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FF04023E" Opacity="0.6"/>
                </Button.Background>
            </Button>
            <Image Margin="352,0,352,339" Source="/logo programa Pagina.png" Stretch="Fill" RenderTransformOrigin="0.493,0.323"/>
            <Button x:Name="Boton_Login" Content="Login" HorizontalAlignment="Left" Margin="258,87,0,0" VerticalAlignment="Top" Background="#FF7385E3" BorderBrush="#FF7385E3" Foreground="White" FontSize="16" Width="154" Height="35" RenderTransformOrigin="0,0" Click="Button_Click_1" OpacityMask="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"/>
            <Rectangle Height="289" Width="328" UseLayoutRounding="True" HorizontalAlignment="Center" VerticalAlignment="Top" RadiusX="26.535" RadiusY="26.535" Margin="0,117,0,0">
                <Rectangle.Stroke>
                    <SolidColorBrush Color="Black" Opacity="0"/>
                </Rectangle.Stroke>
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0,1" StartPoint="1,0" Opacity="0.998">
                        <GradientStop Color="#FFB2CFE6" Offset="0"/>
                        <GradientStop Color="#FF3D8CCC" Offset="0.842"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle HorizontalAlignment="Center" Height="32" Margin="0,226,0,0" Stroke="#FFABADB3" VerticalAlignment="Top" Width="294" Fill="#FFD9D9D9" IsEnabled="False"/>
            <PasswordBox x:Name="txtPassword" HorizontalAlignment="Center" VerticalAlignment="Top" Width="294" Height="32" VerticalContentAlignment="Center" Background="#FFD9D9D9" Foreground="#FF717171" Margin="0,226,0,0" PasswordChanged="txtPassword_PasswordChanged"/>
            <TextBox x:Name="txtEmail" HorizontalAlignment="Center" Margin="0,150,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="294" Height="31" FontFamily="Yu Gothic" FontSize="16" MaxLines="3" VerticalContentAlignment="Center" TextChanged="txtEmail_TextChanged" Background="#FFD9D9D9" Foreground="#FF717171"/>
            <Button Content="Olvido el correo?" HorizontalAlignment="Left" Margin="253,183,0,0" VerticalAlignment="Top" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" FontSize="16"/>
            <Button Content="Olvido la contraseña?" HorizontalAlignment="Left" Margin="253,261,0,0" VerticalAlignment="Top" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" FontSize="16" Click="Button_Click"/>
            <Rectangle HorizontalAlignment="Center" Height="1" Margin="0,137,0,0" Stroke="Black" VerticalAlignment="Top" Width="284"/>
            <Rectangle HorizontalAlignment="Center" Height="2" Stroke="Black" VerticalAlignment="Top" Width="284" Margin="0,395,0,0"/>
            <Button x:Name="Iniciar_Sesion" Content="" HorizontalAlignment="Center" Margin="0,298,0,0" VerticalAlignment="Top" BorderBrush="{x:Null}" Foreground="White" FontSize="16" Click="btnLogin_Click" Width="286" Height="32" IsDefault="True">
                <Button.Background>
                    <ImageBrush ImageSource="/Boton Iniciar sesion.png"/>
                </Button.Background>
            </Button>
            <TextBlock x:Name="txtPlaceholderPass" IsHitTestVisible="False"  HorizontalAlignment="Left" Margin="256,229,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Yu Gothic" FontSize="16">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="#FF717171" Opacity="1"/>
                </TextBlock.Foreground><Run Language="es-mx" Text="Contraseña"/></TextBlock>
            <TextBlock x:Name="txtPlaceholderEmail" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="256,153,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Yu Gothic" FontSize="16">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="#FF717171" Opacity="1"/>
                </TextBlock.Foreground><Run Language="es-mx" Text="Email"/></TextBlock>
            <Button x:Name="Icono_Correo" Content="" HorizontalAlignment="Left" Margin="515,152,0,0" VerticalAlignment="Top" Width="27" BorderBrush="{x:Null}" Height="27">
                <Button.Background>
                    <ImageBrush ImageSource="/Correo.png" Opacity="0.4"/>
                </Button.Background>
            </Button>
            <Button x:Name="Icono_Contraseña" Content="" HorizontalAlignment="Left" Margin="516,234,0,0" VerticalAlignment="Top" Click="Icono_Contraseña_Click" Width="27" BorderBrush="{x:Null}" Foreground="{x:Null}" Height="16">
                <Button.Background>
                    <ImageBrush ImageSource="/Ojo.png" Opacity="0.8"/>
                </Button.Background>
            </Button>

        </Grid>
    </Viewbox>
</UserControl>
