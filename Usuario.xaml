<UserControl x:Class="C.R.A_Consumo_reducido_de_agua.Usuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:C.R.A_Consumo_reducido_de_agua"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF04023E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#FF7385E3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="15">
                            <!-- 🔸 Redondeo de esquinas -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7385E3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="Login_Window" Background="#FF86A5FF" Height="434" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle Stroke="White" Margin="111,56,10,10" Fill="White" RadiusX="17.5" RadiusY="17.5"/>
            <Rectangle HorizontalAlignment="Left" Height="434" Stroke="#FF394D7E" VerticalAlignment="Center" Width="98" Fill="#FF394D7E"/>
            <Button x:Name="Boton_Configuracion" Content="" Click="Boton_ir_a_Inicio" HorizontalAlignment="Left" Margin="20,80,0,0" VerticalAlignment="Top" BorderBrush="#FF7385E3" FontSize="36" Width="58" Height="56" RenderTransformOrigin="0,0" Cursor="Hand">

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FFBBD3F8" Opacity="1"/>
                </Button.Background>
            </Button>
            <Button x:Name="Boton_Reportar" Content="" Click="Boton_Reporte" HorizontalAlignment="Left" Margin="20,368,0,0" VerticalAlignment="Top" BorderBrush="#FF7385E3" FontSize="36" Width="58" Height="56" RenderTransformOrigin="0,0" Cursor="Hand">

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FFBBD3F8" Opacity="1"/>
                </Button.Background>
            </Button>
            <Image Margin="21,10,723,374" Source="/logo programa.png" Stretch="Fill" />
            <Button x:Name="Boton_Usuario" Content=""  HorizontalAlignment="Left" Margin="20,274,0,0" VerticalAlignment="Top" BorderBrush="#FF7385E3" FontSize="36" Width="58" Height="56" RenderTransformOrigin="0.5,0.5" Cursor="Hand">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="45.933"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FFBBD3F8" Opacity="1"/>
                </Button.Background>
            </Button>
            <Button x:Name="Boton_Menu" Content="" Click="Boton_ir_a_Configuracion" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#FF303C73" FontSize="36" Width="58" Height="56" RenderTransformOrigin="0.5,0.5" Margin="49,163,0,0" BorderThickness="100">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="0.447"/>
                        <TranslateTransform X="-28.1381" Y="12.3021"/>
                    </TransformGroup>
                </Button.RenderTransform>

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FFBBD3F8" Opacity="1"/>
                </Button.Background>
            </Button>
            <Image Margin="32,378,734,20" Source="/Reportar.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Image Margin="30,284,730,114" Source="/Usuario e invitados.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Image Margin="29,183,729,211" Source="/Configuracion.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Image Margin="26,90,726,307" Source="/Menu Principal seleccionado.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Image Margin="-796,-7,813,0" Source="/Captura de pantalla 2025-10-17 101012.png" Stretch="Fill"/>
            <Button x:Name="Boton_Register" Content="Invitados" Click="Boton_ir_a_Invitados" HorizontalAlignment="Left" Margin="301,8,0,0" VerticalAlignment="Top" FontSize="16" Width="229" Height="35" RenderTransformOrigin="0,0">
                <Button.BorderBrush>
                    <SolidColorBrush Color="#FF04023E" Opacity="0.6"/>
                </Button.BorderBrush>

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FF04023E" Opacity="0.6"/>
                </Button.Background>
            </Button>
            <Button x:Name="Boton_Login" Content="Usuario Principal" HorizontalAlignment="Left" Margin="111,8,0,0" VerticalAlignment="Top" Background="#FFBDC8FD" BorderBrush="#FF7385E3" Foreground="White" FontSize="16" Width="227" Height="35" RenderTransformOrigin="0,0" OpacityMask="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"/>
            <Rectangle HorizontalAlignment="Left" Height="2" Margin="98,42,0,0" Stroke="#FF212B69" VerticalAlignment="Top" Width="702"/>
            <TextBlock x:Name="Texto_Nombre" HorizontalAlignment="Left" Margin="258,80,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiLight" FontSize="20" Width="513" MaxWidth="513"><Run Text="si este texto llega a salir, reportarlo al "/><LineBreak/><Run Language="es-mx" Text="pendejo de dani que se le olvido que el visual no vale verga"/></TextBlock>
            <Image Margin="126,71,0,254" Source="/Place Holder Foto.jpg" Stretch="Fill" HorizontalAlignment="Left" Width="114"/>
            <TextBlock x:Name="Datos_Usuario" HorizontalAlignment="Left" Margin="126,185,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiLight" FontSize="20" Width="645" MaxWidth="645"><Run Text="Cantidad de domicilios: 1"/><LineBreak/><Run/><LineBreak/><Run Text="Domicilio: Calle placeholder69uwu#666"/><LineBreak/><Run/><LineBreak/><Run Language="es-mx" Text="Invitados: 3000 :O"/><LineBreak/><Run/></TextBlock>
            <Rectangle HorizontalAlignment="Left" Height="2" Margin="144,317,0,0" Stroke="#FF212B69" VerticalAlignment="Top" Width="610"/>
            <TextBlock x:Name="Datos_Usuario_Copiar" TextAlignment="Center" HorizontalAlignment="Left" Margin="126,329,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiLight" FontSize="20" Width="645" MaxWidth="645" Height="24"><Run Language="es-mx" Text="Meta de reduccion de consumo"/></TextBlock>
            <ProgressBar x:Name="Barra_meta" HorizontalAlignment="Left" Height="38" Margin="144,355,0,0" VerticalAlignment="Top" Width="610" Background="#FFB9D5FF" BorderBrush="#FF0A2D65" Value="50" Foreground="#FF5F89C8"/>
            <TextBlock x:Name="Datos_Usuario_Copiar1" TextAlignment="Center" HorizontalAlignment="Left" Margin="144,397,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiLight" FontSize="20" Width="610" MaxWidth="645" Height="24"><Run Language="es-mx" Text="Dias restantes: te te te te teto"/></TextBlock>
        </Grid>
    </Viewbox>
</UserControl>
