<UserControl x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View.Inicio"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:gif="http://wpfanimatedgif.codeplex.com"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
     xmlns:vm="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.ViewModels"
     xmlns:UserControl="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.Controls"
     mc:Ignorable="d"
     d:DesignHeight="500" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF04023E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#FF7385E3"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="1"
                         CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="SaltoStoryboard">
            <DoubleAnimation
         Storyboard.TargetName="btnSaltoTransform"
         Storyboard.TargetProperty="Y"
         From="0" To="-10" Duration="0:0:0.1"
         AutoReverse="True"
         RepeatBehavior="2x"/>
        </Storyboard>

        <vm:PeriodToCheckedConverter x:Key="PeriodToCheckedConverter"/>

    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF92AAE3" Offset="0.32"/>
                <GradientStop Color="#FFCBDAFF" Offset="0.601"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="87"/>
            <RowDefinition Height="269*"/>
            <RowDefinition Height="69*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Rectangle HorizontalAlignment="Center" Height="87" VerticalAlignment="Center" Width="8427">
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FF262E75" Offset="1"/>
                        <GradientStop Color="#FE222271"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock x:Name="Texto_Bienvenida" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="28" FontFamily="Yu Gothic Medium" TextAlignment="Center" Margin="0,4,0,0" Foreground="#FF8FA2DC"><Run Language="es-mx" Text="Texto de bienvenida"/></TextBlock>
            <TextBlock x:Name="Texto_Porcentaje" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="24" FontFamily="Yu Gothic Light" TextAlignment="Center" Margin="0,44,0,0" Foreground="#FF8FA2DC" FontWeight="Bold"><Run Text="Texto consumo del mes"/></TextBlock>
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,71" Grid.RowSpan="3">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF91A9E2" Offset="0"/>
                    <GradientStop Color="#FFCBDAFF" Offset="0.997"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Controles del gráfico -->
            <StackPanel x:Name="Graph1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Width="537" Height="35">
                <Button Margin="0.2,0,5,0" Command="{Binding GoToPage2Command}" Width="121" Background="#FF252C74" FontFamily="Consolas">Week</Button>
                <Button Margin="0.2,0,5,0" Command="{Binding GoToPage3Command}" Width="113" Background="#FF252C74" FontFamily="Consolas">Month</Button>
                <Button Margin="0.2,0,5,0" Command="{Binding SeeAllCommand}" Width="130" Background="#FF262D75" FontFamily="Consolas" Click="Button_Click">Year</Button>
                <Button Width="151" x:Name="btnDownload" Click="btnDownload_Click" Content="Download report" Margin="0.2,0,0,0" Background="#FF242873" FontFamily="Consolas" FontSize="16"/>
            </StackPanel>

            <!-- Gráfico bonito -->
            <Grid Grid.Row="1">
                <Border BorderThickness="4,4,4,4" Margin="129,0,131,76" Background="White">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FF102475" Opacity="0.4"/>
                    </Border.BorderBrush>
                </Border>
                <lvc:CartesianChart x:Name="Chart" Background="Transparent" BorderBrush="WhiteSmoke" ZoomMode="X"
                 Series="{Binding Values}"
                 XAxes="{Binding XAxes}"
                 YAxes="{Binding YAxes}" Margin="134,4,142,86"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="Both">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="texto_consejo" TextWrapping="Wrap" FontFamily="Cascadia Code SemiLight" TextAlignment="Center" Margin="0,-11,0,11" Foreground="#FF071148" FontSize="20"><Run Language="es-mx" Text="Consejos consejosamente consejosos"/></TextBlock>

                    </Grid>
                </Viewbox>

                <Viewbox Grid.Row="1">
                    <TextBlock VerticalAlignment="Bottom" x:Name="texto_modo" FontFamily="Cascadia Code SemiLight" TextAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="Black" Opacity="0.5"/>
                        </TextBlock.Foreground><Run Language="es-mx" Text="Modo :diablo:"/></TextBlock>
                </Viewbox>

            </Grid>

            <Button Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{x:Null}" BorderBrush="{x:Null}" Click="btnSalto_Click">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="btnSaltoTransform" Y="0"/>
                </Button.RenderTransform>
                <Image Stretch="Fill" gif:ImageBehavior.AnimatedSource="/Images/teto-tetoris.gif"/>
            </Button>
            <Button Grid.Column="3" Click="btnSiguiente_Click" Height="36" Width="54" BorderBrush="Transparent" Margin="6,4,6,35">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/flecha.png"/>
                </Button.Background>
            </Button>

            <Image Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stretch="Fill" MaxWidth="75" Source="/Images/perrito chivas.png" />

            <Button Grid.Column="1" Click="btnAnterior_Click" Height="36" Width="54" RenderTransformOrigin="0.5,0.5" BorderBrush="Transparent" Margin="6,4,6,35" >
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-179.517"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Background>
                    <ImageBrush ImageSource="/Images/flecha.png"/>
                </Button.Background>
            </Button>
        </Grid>
        <StackPanel x:Name="Graph1_Copiar" Orientation="Horizontal" Grid.Row="1" Margin="133,262,124,13" Grid.RowSpan="2">
            <Button x:Name="Boton_Eliminar" Content="" Height="52" Width="51" Grid.Row="1" Margin="380,-4,0,0">
                <Button.BorderBrush>
                    <ImageBrush/>
                </Button.BorderBrush>
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Eliminar.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="Boton_Editar" Content="" Height="54" Width="54" Grid.Row="1" Margin="0,-3,0,0">
                <Button.BorderBrush>
                    <ImageBrush/>
                </Button.BorderBrush>
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Editar.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="Boton_Agregar" Content="" Height="54" Width="54" Grid.Row="1" Margin="0,0,100,0">
                <Button.BorderBrush>
                    <ImageBrush/>
                </Button.BorderBrush>
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Agregar.png"/>
                </Button.Background>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
