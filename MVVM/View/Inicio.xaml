<UserControl x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View.Inicio"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:gif="http://wpfanimatedgif.codeplex.com"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
     xmlns:vm="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.ViewModels"
     xmlns:UserControl="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.Controls"
     mc:Ignorable="d"
     d:DesignHeight="500" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF252C74"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#FF7385E3"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="1"
                         CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Storyboard x:Key="SaltoStoryboard">
            <DoubleAnimation
         Storyboard.TargetName="btnSaltoTransform"
         Storyboard.TargetProperty="Y"
         From="0" To="-10" Duration="0:0:0.1"
         AutoReverse="True"
         RepeatBehavior="2x"/>
        </Storyboard>
        <vm:PeriodToCheckedConverter x:Key="PeriodToCheckedConverter"/>
    </UserControl.Resources>
    <Grid >
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF92AAE3" Offset="0.32"/>
                <GradientStop Color="#FFCBDAFF" Offset="0.601"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF262E75" Offset="1"/>
                    <GradientStop Color="#FE222271"/>
                </LinearGradientBrush>
            </Grid.Background>
            <TextBlock x:Name="Texto_Bienvenida" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="28" FontFamily="Yu Gothic Medium" TextAlignment="Center" Margin="0,4,0,0" Foreground="#FF8FA2DC"><Run Language="es-mx" Text="Texto de bienvenida"/></TextBlock>
            <TextBlock x:Name="Texto_Porcentaje" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="24" FontFamily="Yu Gothic Light" TextAlignment="Center" Margin="0,44,0,0" Foreground="#FF8FA2DC" FontWeight="Bold"><Run Text="Texto consumo del mes"/></TextBlock>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Controles del gráfico -->
            <StackPanel x:Name="Graph1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Margin="0.2,0,5,0" Command="{Binding GoToPage2Command}" >Week</Button>
                <Button Margin="0.2,0,5,0" Command="{Binding GoToPage3Command}">Month</Button>
                <Button Margin="0.2,0,5,0" Command="{Binding SeeAllCommand}" Click="Button_Click">Year</Button>
                <Button Width="150" x:Name="btnDownload" Click="btnDownload_Click" Content="Download report"/>
                <Button x:Name="Boton_Eliminar" Height="50" Margin="10,0,0,0">
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Eliminar.png"/>
                    </Button.Background>
                </Button>
                <Button x:Name="Boton_Editar" Height="50" Margin="10,0,0,0" Click="Boton_Editar_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Editar.png"/>
                    </Button.Background>
                </Button>
                <Button x:Name="Boton_Agregar" Height="50" Margin="10,0,0,0">
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Agregar.png"/>
                    </Button.Background>
                </Button>
            </StackPanel>

            <!-- Gráfico bonito -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <lvc:CartesianChart Grid.Column="1" x:Name="Chart" Background="White" BorderThickness="3" BorderBrush="#FF262E75" ZoomMode="X"
                 Series="{Binding Values}"
                 XAxes="{Binding XAxes}"
                 YAxes="{Binding YAxes}"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="Both">
                    <Grid>
                        <TextBlock x:Name="texto_consejo" TextWrapping="Wrap" FontFamily="Cascadia Code SemiLight" TextAlignment="Center" Foreground="#FF071148" FontSize="16"><Run Language="es-mx" Text="Consejos consejosamente consejosos"/></TextBlock>
                    </Grid>
                </Viewbox>
                <Viewbox Grid.Row="1">
                    <TextBlock VerticalAlignment="Bottom" x:Name="texto_modo" FontFamily="Cascadia Code SemiLight" TextAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="Black" Opacity="0.5"/>
                        </TextBlock.Foreground><Run Language="es-mx" Text="Modo :diablo:"/></TextBlock>
                </Viewbox>
            </Grid>
            <Viewbox Grid.Column="4">
                <Button x:Name="btnSalto" Height="75" Width="75" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{x:Null}" BorderBrush="{x:Null}" Click="btnSalto_Click">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="btnSaltoTransform" Y="0"/>
                    </Button.RenderTransform>
                    <Image Stretch="Uniform" gif:ImageBehavior.AnimatedSource="/Images/teto-tetoris.gif"/>
                </Button>
            </Viewbox>
            <Viewbox Grid.Column="3" MaxWidth="100">
                <Button Click="btnSiguiente_Click" BorderBrush="Transparent">
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/flecha.png"/>
                    </Button.Background>
                </Button>
            </Viewbox>
            <Image Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stretch="Uniform" Source="/Images/perrito chivas.png" />
            <Viewbox Grid.Column="1" MaxWidth="100">
                <Button Grid.Column="1" Click="btnAnterior_Click" RenderTransformOrigin="0.5,0.5" BorderBrush="Transparent" >
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="-179.517"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/flecha.png"/>
                    </Button.Background>
                </Button>
            </Viewbox>
        </Grid>
    </Grid>
</UserControl>