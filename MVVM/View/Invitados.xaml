
<UserControl x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View.Invitados"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF04023E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#FF7385E3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="15">
                            <!-- 🔸 Redondeo de esquinas -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7385E3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="Login_Window" Background="#FF86A5FF" Height="434" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle Stroke="White" Margin="111,56,10,10" Fill="White" RadiusX="17.5" RadiusY="17.5"/>
            <Rectangle HorizontalAlignment="Left" Height="434" Stroke="#FF394D7E" VerticalAlignment="Center" Width="98" Fill="#FF394D7E"/>
            <Button x:Name="Boton_Usuarios" Content="Usuario Principal"  Command="{Binding NavigateToUsuariosCommand}" HorizontalAlignment="Left" Margin="111,8,0,0" VerticalAlignment="Top" BorderBrush="#FF7385E3" FontSize="16" Width="227" Height="35" RenderTransformOrigin="0,0" OpacityMask="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}">
                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FF04023E" Opacity="0.6"/>
                </Button.Background>
            </Button>
            <Button x:Name="Boton_Invitados" Content="Invitados"  HorizontalAlignment="Left" Margin="301,8,0,0" VerticalAlignment="Top" FontSize="16" Width="229" Height="35" RenderTransformOrigin="0,0">
                <Button.BorderBrush>
                    <SolidColorBrush Color="#FF04023E" Opacity="0.6"/>
                </Button.BorderBrush>

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="1"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FFBDC8FD" Opacity="1"/>
                </Button.Background>
            </Button>
            <Rectangle HorizontalAlignment="Left" Height="2" Margin="98,42,0,0" Stroke="#FF212B69" VerticalAlignment="Top" Width="702"/>
            <Image x:Name="Foto" Margin="575,93,0,280" Source="Images/Place Holder Foto.jpg" Stretch="Fill" HorizontalAlignment="Left" Width="68"/>
            <Rectangle HorizontalAlignment="Left" Height="2" Margin="128,167,0,0" Stroke="#FF212B69" VerticalAlignment="Top" Width="610"/>
            <TextBlock x:Name="Nombre"  HorizontalAlignment="Left" Margin="128,108,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiLight" FontSize="20" Width="423" MaxWidth="645" Height="24"><Run Language="es-mx" Text="Nombre para medir texto para los nombres y aja"/></TextBlock>
            <Image x:Name="Foto_2" Margin="575,183,0,190" Source="/Images/Place Holder Foto.jpg" Stretch="Fill" HorizontalAlignment="Left" Width="68"/>
            <Rectangle HorizontalAlignment="Left" Height="2" Margin="128,256,0,0" Stroke="#FF212B69" VerticalAlignment="Top" Width="610"/>
            <TextBlock x:Name="Nombre_2"  HorizontalAlignment="Left" Margin="128,198,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiLight" FontSize="20" Width="423" MaxWidth="645" Height="24"><Run Language="es-mx" Text="Nombre para medir texto para los nombres y aja"/></TextBlock>
        </Grid>
    </Viewbox>
</UserControl>
