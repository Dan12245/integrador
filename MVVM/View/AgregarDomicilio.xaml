<Window x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View.AgregarDomicilio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View"
        mc:Ignorable="d"
        Title="Add building"         Height="300" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nombre -->
        <TextBlock Grid.Row="0" Text="Name:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox x:Name="txtNombre" Grid.Row="1" Padding="5" Margin="0,0,0,15"/>

        <!-- Apellido -->
        <TextBlock Grid.Row="2" FontSize="14" Margin="0,0,0,5"><Run Language="es-mx" Text="Description:"/></TextBlock>
        <TextBox x:Name="Descripcion_Texto" Grid.Row="3" Padding="5" Margin="0,0,0,15"/>


        <!-- Botones -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnAceptar" 
                Content="Accept" 
                Width="100" 
                Height="35" 
                Margin="0,0,10,0"
                Click="BtnAceptar_Click"
                IsDefault="True"/>
            <Button x:Name="btnCancelar" 
                Content="Cancel" 
                Width="100" 
                Height="35"
                Click="BtnCancelar_Click"
                IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
