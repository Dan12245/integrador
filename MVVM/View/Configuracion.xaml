<UserControl x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View.Configuracion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModel="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF04023E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#FF7385E3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="15">
                            <!-- 🔸 Redondeo de esquinas -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7385E3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="Login_Window" Background="#FFB2CEF6" Height="434" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle Stroke="#FF5881E8" Margin="0,0,0,351" Fill="#FF5881E8"/>

            <Label Content="Tamaño de texto" HorizontalAlignment="Left" Margin="117,100,0,0" VerticalAlignment="Top" FontFamily="Yu Gothic UI Semibold" FontSize="20"/>
            <Label Content="Idioma" HorizontalAlignment="Left" Margin="117,175,0,0" VerticalAlignment="Top" FontFamily="Yu Gothic UI Semibold" FontSize="20"/>
            <Label Content="Talkback" HorizontalAlignment="Left" Margin="117,261,0,0" VerticalAlignment="Top" FontSize="20" FontFamily="Yu Gothic UI Semibold"/>
            <Label Content="Rendimiento" HorizontalAlignment="Left" Margin="470,102,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.061,-0.405" FontSize="20" FontFamily="Yu Gothic UI Semibold"/>
            <ComboBox x:Name="Tamaño" HorizontalAlignment="Left" Margin="122,133,0,0" VerticalAlignment="Top" Width="278" Height="33"/>
            <ComboBox x:Name="Talkback" HorizontalAlignment="Left" Margin="122,292,0,0" VerticalAlignment="Top" Width="278" Height="33"/>
            <ComboBox x:Name="Idioma" HorizontalAlignment="Left" Margin="122,208,0,0" VerticalAlignment="Top" Width="278" Height="33"/>
            <ComboBox x:Name="Rendimiento" HorizontalAlignment="Left" Margin="476,134,0,0" VerticalAlignment="Top" Width="278" Height="33"/>
            <!-- Centralized navigation: go to Login using the shell's NavigateToCommand -->
            <Button Content="Cerrar sesion"
                    Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{x:Type viewModel:LoginViewModel}"
                    HorizontalAlignment="Left" Margin="496,282,0,0" VerticalAlignment="Top" Height="54" Width="248"/>
            <Button Content="Descartar" HorizontalAlignment="Left" Margin="137,369,0,0" VerticalAlignment="Top" Height="54" Width="297" Background="#FFFFBEBE" Foreground="#FF752D2D" BorderBrush="#FFFFBEBE"/>
            <Button Content="Aplicar" HorizontalAlignment="Left" Margin="467,369,0,0" VerticalAlignment="Top" Height="54" Width="297" Background="#FF96FFD7" Foreground="#FF276F54" BorderBrush="#FF96FFD7"/>
            <Button Content="Eliminar Cuenta" Click="Boton_Eliminar_Usuario" HorizontalAlignment="Left" Margin="496,208,0,0" VerticalAlignment="Top"  Height="54" Width="248"/>
        </Grid>
    </Viewbox>
    </UserControl>
