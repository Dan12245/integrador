<UserControl x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View.Configuracion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModel="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF04023E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#FF7385E3"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="1"
                         CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="SaltoStoryboard">
            <DoubleAnimation
         Storyboard.TargetName="btnSaltoTransform"
         Storyboard.TargetProperty="Y"
         From="0" To="-10" Duration="0:0:0.1"
         AutoReverse="True"
         RepeatBehavior="2x"/>
        </Storyboard>

    </UserControl.Resources>

    <Grid>

        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF92AAE3" Offset="0.32"/>
                <GradientStop Color="#FFCBDAFF" Offset="0.601"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="101*"/>
                <ColumnDefinition Width="99*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="90*"/>
                <RowDefinition Height="117*"/>
                <RowDefinition Height="97*"/>
                <RowDefinition Height="145*"/>
            </Grid.RowDefinitions>
            <Grid Grid.ColumnSpan="2">
                <Rectangle HorizontalAlignment="Center" Height="87" VerticalAlignment="Top" Width="8426">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black"/>
                            <GradientStop Color="#FF262E75" Offset="1"/>
                            <GradientStop Color="#FE222271"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock x:Name="Texto_Bienvenida" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="48" FontFamily="Yu Gothic Medium" TextAlignment="Center" Margin="26,5,0,0" Foreground="#FF8FA2DC" HorizontalAlignment="Left"><Run Language="es-mx" Text="Configuration"/></TextBlock>
            </Grid>
            <Viewbox Grid.Row="2" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="0,3,0,0"/>
            <TextBlock x:Name="Texto_Bienvenida_Copiar" TextWrapping="Wrap" FontSize="28" FontFamily="Yu Gothic Medium" TextAlignment="Center" Margin="10,0,0,83" Foreground="#FF11245F" Grid.RowSpan="2" HorizontalAlignment="Left" Width="220" Height="34" VerticalAlignment="Bottom"><Run Language="es-mx" Text="Text size"/></TextBlock>
            <ComboBox x:Name="Tamaño_Texto" HorizontalAlignment="Left" Margin="10,0,0,31" Width="296" BorderBrush="#FF121482" Grid.Row="1" Height="36" VerticalAlignment="Bottom">
                <ComboBoxItem Content="Small" FontSize="20"/>
                <ComboBoxItem Content="Medium" FontSize="24"/>
                <ComboBoxItem Content="Big" FontSize="36"/>
            </ComboBox>
            <TextBlock x:Name="Texto_Bienvenida_Copiar1" TextWrapping="Wrap" FontSize="28" FontFamily="Yu Gothic Medium" TextAlignment="Center" Margin="24,4,152,79" Foreground="#FF11245F" Grid.Column="1" Grid.Row="1"><Run Language="es-mx" Text=":v"/></TextBlock>
            <ComboBox x:Name="Tamaño_Texto_Copiar" HorizontalAlignment="Right" Margin="0,50,76,0" VerticalAlignment="Top" Width="296" BorderBrush="#FF121482" Height="36" Grid.Row="1" Grid.Column="1">
                <ComboBoxItem Content="Small" FontSize="20"/>
                <ComboBoxItem Content="Medium" FontSize="24"/>
                <ComboBoxItem Content="Big" FontSize="36"/>
            </ComboBox>
            <TextBlock x:Name="Texto_Bienvenida_Copiar2" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="28" FontFamily="Yu Gothic Medium" TextAlignment="Center" Margin="10,8,0,0" Foreground="#FF11245F" HorizontalAlignment="Left" Height="44" Width="148" Grid.Row="3"><Run Language="es-mx" Text="Language"/><LineBreak/><Run Language="es-mx"/></TextBlock>
            <ComboBox x:Name="Tamaño_Texto_Copiar1" HorizontalAlignment="Left" Margin="10,56,0,0" VerticalAlignment="Top" Width="296" BorderBrush="#FF121482" Height="36" Grid.Row="3">
                <ComboBoxItem Content="Small" FontSize="20"/>
                <ComboBoxItem Content="Medium" FontSize="24"/>
                <ComboBoxItem Content="Big" FontSize="36"/>
            </ComboBox>
            <TextBlock x:Name="Texto_Bienvenida_Copiar3" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="28" FontFamily="Yu Gothic Medium" TextAlignment="Center" Margin="24,14,0,0" Foreground="#FF11245F" HorizontalAlignment="Left" Height="44" Width="220" Grid.Row="3" Grid.Column="1"><Run Language="es-mx" Text="Graph color"/></TextBlock>
            <ComboBox x:Name="Tamaño_Texto_Copiar2" HorizontalAlignment="Left" Margin="24,64,0,0" VerticalAlignment="Top" Width="296" BorderBrush="#FF121482" Height="36" Grid.Row="3" Grid.Column="1">
                <ComboBoxItem Content="Small" FontSize="20"/>
                <ComboBoxItem Content="Medium" FontSize="24"/>
                <ComboBoxItem Content="Big" FontSize="36"/>
            </ComboBox>
            <TextBlock x:Name="Texto_Bienvenida_Copiar4" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="28" FontFamily="Yu Gothic Medium" TextAlignment="Center" Margin="10,5,0,0" Foreground="#FF11245F" HorizontalAlignment="Left" Height="44" Width="124" Grid.Row="2"><Run Language="es-mx" Text="Talkback"/><LineBreak/><Run Language="es-mx"/></TextBlock>
            <ComboBox x:Name="Tamaño_Texto_Copiar3" HorizontalAlignment="Left" Margin="10,55,0,0" VerticalAlignment="Top" Width="296" BorderBrush="#FF121482" Height="36" Grid.Row="2">
                <ComboBoxItem Content="Small" FontSize="20"/>
                <ComboBoxItem Content="Medium" FontSize="24"/>
                <ComboBoxItem Content="Big" FontSize="36"/>
            </ComboBox>
            <TextBlock x:Name="Texto_Bienvenida_Copiar5" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="28" FontFamily="Yu Gothic Medium" TextAlignment="Center" Margin="24,7,0,0" Foreground="#FF11245F" HorizontalAlignment="Left" Height="44" Width="220" Grid.Row="2" Grid.Column="1"><Run Language="es-mx" Text="Text size"/></TextBlock>
            <ComboBox x:Name="Tamaño_Texto_Copiar4" HorizontalAlignment="Left" Margin="24,55,0,0" VerticalAlignment="Top" Width="296" BorderBrush="#FF121482" Height="36" Grid.Row="2" Grid.Column="1">
                <ComboBoxItem Content="Small" FontSize="20"/>
                <ComboBoxItem Content="Medium" FontSize="24"/>
                <ComboBoxItem Content="Big" FontSize="36"/>
            </ComboBox>
        </Grid>

    </Grid>
</UserControl>
