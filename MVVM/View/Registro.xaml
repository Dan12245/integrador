<UserControl x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View.Registro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF04023E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#FF7385E3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="15">
                            <!-- 🔸 Redondeo de esquinas -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7385E3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="Login_Window" Background="#FFB2CFE6" Height="434" Width="800" KeyboardNavigation.TabNavigation="Cycle">

            <Image Margin="-187,48,547,-53" Source="/Images/descarga.png" Stretch="Fill"/>
            <Image x:Name="MareaImage" Margin="-76,343,-182,-146" Source="/Images/Marea.png" Stretch="Fill"/>
            <Rectangle Height="426" Width="392" UseLayoutRounding="True" HorizontalAlignment="Center" VerticalAlignment="Center" RadiusX="26.535" RadiusY="26.535">
                <Rectangle.Stroke>
                    <SolidColorBrush Color="Black" Opacity="0"/>
                </Rectangle.Stroke>
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.6">
                        <GradientStop Color="#FF8BA6BF"/>
                        <GradientStop Color="#FF3757A9" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Button x:Name="Boton_Login" Content="Login" Command="{Binding NavigateToLoginCommand}" HorizontalAlignment="Left" Margin="258,87,0,0" TabIndex="5"
                    VerticalAlignment="Top" FontSize="16" Width="156" Height="35" RenderTransformOrigin="0,0">
                <Button.BorderBrush>
                    <SolidColorBrush Color="#FF04023E" Opacity="0.6"/>
                </Button.BorderBrush>

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FF04023E" Opacity="0.6"/>
                </Button.Background>
            </Button>
            <Button x:Name="Boton_Register" Content="Register" HorizontalAlignment="Left" Margin="388,87,0,0" VerticalAlignment="Top" TabIndex="6"
                    Background="#FF7385E3" BorderBrush="#FF7385E3" Foreground="White" FontSize="16" Width="154" Height="35" RenderTransformOrigin="0,0"  OpacityMask="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"/>
            <Image Margin="0,0,0,342" Width="75" Source="/Images/Logo.png"/>
            <Rectangle Height="289" Width="328" UseLayoutRounding="True" HorizontalAlignment="Center" VerticalAlignment="Top" RadiusX="26.535" RadiusY="26.535" Margin="0,117,0,0">
                <Rectangle.Stroke>
                    <SolidColorBrush Color="Black" Opacity="0"/>
                </Rectangle.Stroke>
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0,1" StartPoint="1,0" Opacity="0.998">
                        <GradientStop Color="#FFB2CFE6" Offset="0"/>
                        <GradientStop Color="#FF3D8CCC" Offset="0.842"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <PasswordBox x:Name="Campo_Contraseña" HorizontalAlignment="Center" Margin="0,253,0,0" VerticalAlignment="Top" TabIndex="2"
                         Width="294" Height="32" VerticalContentAlignment="Center" Background="#FFD9D9D9" Foreground="#FF717171" PasswordChanged="PasswordPlaceHolder"/>
            <TextBox x:Name="Campo_Email" HorizontalAlignment="Center" TextChanged="PlaceHolderTexto" TabIndex="1"
                     VerticalAlignment="Center" Width="294" Height="30" FontFamily="Yu Gothic" FontSize="16" MaxLines="3" VerticalContentAlignment="Center"  Background="#FFD9D9D9" Foreground="#FF717171"/>
            <Rectangle HorizontalAlignment="Center" Height="1" Margin="0,137,0,0" Stroke="Black" VerticalAlignment="Top" Width="284"/>
            <Rectangle HorizontalAlignment="Center" Height="2" Stroke="Black" VerticalAlignment="Top" Width="284" Margin="0,395,0,0"/>
            <Button x:Name="Registrarse" Content="" Click="Boton_Registrarse" HorizontalAlignment="Center" Margin="0,353,0,0" TabIndex="4"
                    VerticalAlignment="Top" BorderBrush="{x:Null}" Foreground="White" FontSize="16"  Width="286" Height="32" IsDefault="True">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Boton Registrarse.png"/>
                </Button.Background>
            </Button>
            <PasswordBox x:Name="Campo_Repetir_Contraseña" HorizontalAlignment="Center" Margin="0,305,0,0" VerticalAlignment="Top" TabIndex="3"
                         Width="294" Height="31" VerticalContentAlignment="Center" Background="#FFD9D9D9" Foreground="#FF717171" PasswordChanged="PasswordPlaceHolder"/>
            <TextBox x:Name="Campo_Nombre" HorizontalAlignment="Center" TextChanged="PlaceHolderTexto" Margin="0,150,0,0" TabIndex="0"
                     VerticalAlignment="Top" Width="294" Height="30" FontFamily="Yu Gothic" FontSize="16" MaxLines="3" VerticalContentAlignment="Center"  Background="#FFD9D9D9" Foreground="#FF717171"/>
            <TextBlock x:Name="email_place_holder" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="257,0,0,0" VerticalAlignment="Center" FontFamily="Yu Gothic" FontSize="16">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="#FF717171" Opacity="1"/>
                </TextBlock.Foreground><Run Language="es-mx" Text="Email"/></TextBlock>
            <TextBlock x:Name="contraseña_place_holder" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="257,256,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Yu Gothic" FontSize="16">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="#FF717171" Opacity="1"/>
                </TextBlock.Foreground><Run Language="es-mx" Text="Contraseña"/><LineBreak/><Run Language="es-mx"/></TextBlock>
            <TextBlock x:Name="repetir_contraseña_place_holder" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="257,308,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Yu Gothic" FontSize="16">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="#FF717171" Opacity="1"/>
                </TextBlock.Foreground><Run Language="es-mx" Text="Repetir Contraseña"/></TextBlock>
            <TextBlock x:Name="nombre_place_holder" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="257,152,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Yu Gothic" FontSize="16">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="#FF717171" Opacity="1"/>
                </TextBlock.Foreground><Run Language="es-mx" Text="Nombre"/></TextBlock>

        </Grid>
    </Viewbox>
</UserControl>
