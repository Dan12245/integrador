<UserControl x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View.Reporte"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
 xmlns:viewModel="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.ViewModel"
 mc:Ignorable="d" 
 d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF04023E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#FF7385E3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="1" 
 CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7385E3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="Login_Window" Height="500" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF91A9E2"/>
                    <GradientStop Color="#FFCBDAFF" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Barra superior -->
            <Rectangle Margin="0,0,0,417" Fill="#FF262E75"/>

            <!-- Título -->
            <TextBlock x:Name="Texto_Bienvenida" 
                       TextWrapping="Wrap" 
                       VerticalAlignment="Top" 
                       FontSize="36" 
                       FontFamily="Yu Gothic Medium" 
                       TextAlignment="Center" 
                       Margin="0,13,0,0" 
                       Foreground="#FF8FA2DC" 
                       Text="Reporte de Bugs o Errores !"/>

            <!-- Imágenes de advertencia -->
            <Image Margin="106,24,654,441" Source="/Images/Advertencia.png" Stretch="Fill"/>
            <Image Margin="650,24,110,441" Source="/Images/Advertencia.png" Stretch="Fill"/>

            <!-- Tipo de error -->
            <TextBlock x:Name="Texto" 
                       HorizontalAlignment="Center" 
                       TextAlignment="Center" 
                       Margin="0,92,0,0" 
                       TextWrapping="Wrap" 
                       VerticalAlignment="Top" 
                       FontFamily="Cascadia Mono SemiLight" 
                       FontSize="20" 
                       Width="780" 
                       Foreground="#FF273A36">
                <Run Language="es-mx" Text="Seleccione el tipo de reporte:"/>
            </TextBlock>

            <ComboBox x:Name="ErrorTypeComboBox" 
                      HorizontalAlignment="Center" 
                    
                      Margin="0,126,0,0" 
                      VerticalAlignment="Top" 
                      Width="558" 
                      Height="29"
                      SelectedIndex="0" FontSize="18" FontFamily="Corbel">
                <ComboBoxItem Content="Error de Funcionalidad"/>
                <ComboBoxItem Content="Error Visual/UI"/>
                <ComboBoxItem Content="Error de Rendimiento"/>
                <ComboBoxItem Content="Crash/Cierre Inesperado"/>
                <ComboBoxItem Content="Otro"/>
            </ComboBox>

            <!-- Severidad -->

            <!-- Descripción -->
            <TextBlock x:Name="Texto_Copiar" 
                       TextAlignment="Center" 
                       HorizontalAlignment="Center" 
                       Margin="0,170,0,0" 
                       TextWrapping="Wrap" 
                       VerticalAlignment="Top" 
                       FontFamily="Cascadia Mono SemiLight" 
                       FontSize="18" 
                       Width="780" 
                       Foreground="#FF273A36">
                <Run Language="es-mx" Text="Describa de manera breve el problema que se le presentó:"/>
            </TextBlock>

            <TextBox x:Name="DescriptionTextBox" 
                     HorizontalAlignment="Center" 
                     Margin="0,196,0,0" 
                     TextWrapping="Wrap" 
                     VerticalAlignment="Top" 
                     Width="750" 
                     Height="190"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>

            <!-- Botón Reportar -->
            <Button x:Name="ReportButton"
                    Content="Reportar" 
                    HorizontalAlignment="Right" 
                    Margin="0,415,30,0" 
                    VerticalAlignment="Top" 
                    Background="#FFFFBEBE" 
                    BorderBrush="#FF84536E" 
                    Foreground="#FF9A1D1D" 
                    Height="41" 
                    Width="200" 
                    FontSize="28" 
                    FontFamily="Tw Cen MT"
                    Click="SubmitReport_Click"/>

            <!-- Botón Ver Reportes -->
            <Button x:Name="ViewReportsButton"
                    Content="Ver Reportes" 
                    HorizontalAlignment="Left" 
                    Margin="370,415,0,0" 
                    VerticalAlignment="Top" 
                    Background="#FF7385E3" 
                    BorderBrush="#FF04023E" 
                    Foreground="White" 
                    Height="41" 
                    Width="180" 
                    FontSize="22" 
                    FontFamily="Tw Cen MT"
                    Click="ViewReports_Click"/>

            <!-- Mensaje motivacional -->
            <TextBlock x:Name="Texto_Copiar1" 
                       TextAlignment="Center" 
                       HorizontalAlignment="Left" 
                       Margin="10,423,0,0" 
                       TextWrapping="Wrap" 
                       VerticalAlignment="Top" 
                       FontFamily="Cascadia Mono SemiLight" 
                       FontSize="18" 
                       Width="345" 
                       Foreground="#FF273A36">
                <Run Language="es-mx" Text="¡Tu feedback siempre es bueno!"/>
            </TextBlock>
        </Grid>
    </Viewbox>
</UserControl>