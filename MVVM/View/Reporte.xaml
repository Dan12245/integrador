<UserControl x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View.Reporte"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
 xmlns:viewModel="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.ViewModel"
 mc:Ignorable="d" 
 d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF04023E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#FF7385E3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="1" 
 CornerRadius="15">
                            <!-- 🔸 Redondeo de esquinas -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7385E3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="Login_Window" Background="#FFB2CEF6" Height="434" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle Stroke="#FF5881E8" Margin="98,0,0,351" Fill="#FF5881E8"/>

            <Image Margin="103,0,67,351" Source="/Reporte bugs texto.png" Stretch="Fill"/>
            <TextBlock x:Name="Texto" HorizontalAlignment="Left" Margin="114,92,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiLight" FontSize="20" Width="514" MaxWidth="513" Foreground="#FF273A36"><Run Language="es-mx" Text="Select what is the problem related to:"/></TextBlock>
            <ComboBox HorizontalAlignment="Left" Margin="114,120,0,0" VerticalAlignment="Top" Width="656" Height="35"/>
            <TextBlock x:Name="Texto_Copiar" HorizontalAlignment="Left" Margin="113,171,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiLight" FontSize="20" Width="657" Foreground="#FF273A36"><Run Language="es-mx" Text="Describe briefly the problem:"/></TextBlock>
            <TextBox HorizontalAlignment="Left" Margin="114,199,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="656" Height="168" MaxWidth="656"/>
            <Button Content="Reportar" HorizontalAlignment="Left" Margin="478,378,0,0" VerticalAlignment="Top" Background="#FFFFBEBE" BorderBrush="#FFFFBEBE" Foreground="#FF866464" Height="41" Width="292" FontSize="36" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" FontFamily="Tw Cen MT"/>
        </Grid>
    </Viewbox>
</UserControl>

