<UserControl x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View.Usuario"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
 xmlns:viewModel="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.ViewModel"
 mc:Ignorable="d" 
 d:DesignHeight="450" d:DesignWidth="800">
 <UserControl.Resources>
 <Style TargetType="Button">
 <Setter Property="Background" Value="#FF04023E"/>
 <Setter Property="Foreground" Value="White"/>
 <Setter Property="FontSize" Value="16"/>
 <Setter Property="BorderBrush" Value="#FF7385E3"/>
 <Setter Property="Template">
 <Setter.Value>
 <ControlTemplate TargetType="Button">
 <Border Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="1" 
 CornerRadius="15">
 <!-- 🔸 Redondeo de esquinas -->
 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
 </Border>
 </ControlTemplate>
 </Setter.Value>
 </Setter>
 <Style.Triggers>
 <Trigger Property="IsMouseOver" Value="True">
 <Setter Property="Background" Value="#FF7385E3"/>
 <Setter Property="Foreground" Value="White"/>
 </Trigger>
 </Style.Triggers>
 </Style>
 </UserControl.Resources>

 <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
 <Grid x:Name="Login_Window" Background="#FF86A5FF" Height="434" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center">
 <Rectangle Stroke="White" Margin="111,56,10,10" Fill="White" RadiusX="17.5" RadiusY="17.5"/>
 
 <Button x:Name="Boton_Register" Content="Invitados"
 Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
 CommandParameter="{x:Type viewModel:InvitadosViewModel}"
 HorizontalAlignment="Left" Margin="301,8,0,0" VerticalAlignment="Top" FontSize="16" Width="229" Height="35" RenderTransformOrigin="0,0">
 <Button.BorderBrush>
 <SolidColorBrush Color="#FF04023E" Opacity="0.6"/>
 </Button.BorderBrush>

 <Button.Foreground>
 <SolidColorBrush Color="White" Opacity="0.4"/>
 </Button.Foreground>
 <Button.Background>
 <SolidColorBrush Color="#FF04023E" Opacity="0.6"/>
 </Button.Background>
 </Button>
 <Button x:Name="Boton_Login" Content="Usuario Principal" HorizontalAlignment="Left" Margin="111,8,0,0" VerticalAlignment="Top" Background="#FFBDC8FD" BorderBrush="#FF7385E3" Foreground="White" FontSize="16" Width="227" Height="35" RenderTransformOrigin="0,0" OpacityMask="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"/>
 <Rectangle HorizontalAlignment="Left" Height="2" Margin="98,42,0,0" Stroke="#FF212B69" VerticalAlignment="Top" Width="702"/>
 <TextBlock x:Name="Texto_Nombre" HorizontalAlignment="Left" Margin="258,80,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiLight" FontSize="20" Width="247" MaxWidth="513"><Run Text="si este texto llega a salir, reportarlo al "/><LineBreak/><Run Language="es-mx" Text="pendejo de dani que se le olvido que el visual no vale verga"/></TextBlock>
 <Image Margin="126,71,0,254" Source="/Images/Place Holder Foto.jpg" Stretch="Fill" HorizontalAlignment="Left" Width="114"/>
 <TextBlock x:Name="Datos_Usuario" HorizontalAlignment="Left" Margin="126,284,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiLight" FontSize="20" Width="645" MaxWidth="645" Height="28"><Run Text="Invitados:3000 :O"/><LineBreak/><Run/></TextBlock>
 <Rectangle HorizontalAlignment="Left" Height="2" Margin="144,317,0,0" Stroke="#FF212B69" VerticalAlignment="Top" Width="610"/>
 <TextBlock x:Name="Datos_Usuario_Copiar" TextAlignment="Center" HorizontalAlignment="Left" Margin="126,329,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiLight" FontSize="20" Width="645" MaxWidth="645" Height="24"><Run Language="es-mx" Text="Meta de reduccion de consumo"/></TextBlock>
 <ProgressBar x:Name="Barra_meta" HorizontalAlignment="Left" Height="38" Margin="144,355,0,0" VerticalAlignment="Top" Width="610" Background="#FFB9D5FF" BorderBrush="#FF0A2D65" Value="50" Foreground="#FF5F89C8"/>
 <TextBlock x:Name="Datos_Usuario_Copiar1" TextAlignment="Center" HorizontalAlignment="Left" Margin="144,397,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiLight" FontSize="20" Width="610" MaxWidth="645" Height="24"><Run Language="es-mx" Text="Dias restantes: te te te te teto"/></TextBlock>
 <TextBox x:Name="Domicilio_1" HorizontalAlignment="Left" Margin="538,102,0,0" TextWrapping="Wrap" Text="Domicilio1" VerticalAlignment="Top" Width="235"/>
 <TextBox x:Name="Domicilio_2" HorizontalAlignment="Left" Margin="538,139,0,0" TextWrapping="Wrap" Text="Domicilio2" VerticalAlignment="Top" Width="235"/>
 <TextBox x:Name="Domilicio_3" HorizontalAlignment="Left" Margin="538,178,0,0" TextWrapping="Wrap" Text="Domicilio3" VerticalAlignment="Top" Width="235"/>
 <TextBox x:Name="Domicilio_Principal" HorizontalAlignment="Left" Margin="538,64,0,0" TextWrapping="Wrap" Text="Domicilio Principal" VerticalAlignment="Top" Width="235"/>
 <Button Content="Agregar" HorizontalAlignment="Left" Margin="523,217,0,0" VerticalAlignment="Top" Width="76" Height="32" Click="Button_Agregar" BorderBrush="#FF7385E3"/>
 <Button Content="Quitar" HorizontalAlignment="Left" Margin="617,217,0,0" VerticalAlignment="Top" Width="76" Height="32" Click="Button_Quitar" BorderBrush="#FF7385E3"/>
 <Button Content="Editar" HorizontalAlignment="Left" Margin="709,217,0,0" VerticalAlignment="Top" Width="76" Height="32" Click="Button_Editar" BorderBrush="#FF7385E3"/>
 </Grid>
 </Viewbox>
</UserControl>