<Window x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.Controls"
        Title="Consumo Reducido de Agua (C.R.A)"
        WindowStartupLocation="CenterScreen"
        Background="#FFB2CFE6"
        Width="1024"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        ResizeMode="CanResize"
        Icon="/Images/Logo.png">

    <Grid x:Name="RootContainer">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFB2CFE6" Offset="0.436"/>
                <GradientStop Color="White" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn" Width="0" MinWidth="0"/>
                    <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Persistent left menu (hidden during startup animation) -->
        <uc:Menu x:Name="LeftMenu" Grid.Column="0" Visibility="Collapsed"/>

        <!-- Right content area -->
        <Grid Grid.Column="1">
            <!-- Host de navigation (content under overlay) -->
            <ContentControl x:Name="ShellContent"
                            Content="{Binding Navigation.CurrentView}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>

            <!-- Startup animation overlay on top -->
            <Viewbox x:Name="StartupView" Stretch="Uniform" StretchDirection="Both" Panel.ZIndex="10">
                <Grid x:Name="ContentContainer" Width="800" Height="450">
                    <Grid x:Name="Login_Window" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="79*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="LogoInicio"
                               Source="/Images/Logo.png"
                               Width="250"
                               RenderTransformOrigin="0.5,0.5"
                               Opacity="0" OpacityMask="Black" Margin="275,0,265,0">
                            <Image.RenderTransform>
                                <TranslateTransform Y="100"/>
                            </Image.RenderTransform>
                        </Image>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Grid.Loaded">
                                <BeginStoryboard>
                                    <Storyboard x:Name="LogoAnimacion" Completed="LogoAnimacion_Completed">
                                        <DoubleAnimation Storyboard.TargetName="LogoInicio"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:1"/>
                                        <DoubleAnimation Storyboard.TargetName="LogoInicio"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="100" To="0"
                                                         Duration="0:0:1"/>
                                        <DoubleAnimation Storyboard.TargetName="LogoInicio"
                                                         Storyboard.TargetProperty="Opacity"
                                                         BeginTime="0:0:2"
                                                         From="1" To="0"
                                                         Duration="0:0:1"/>
                                        <DoubleAnimation Storyboard.TargetName="LogoInicio"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         BeginTime="0:0:2"
                                                         From="0" To="-50"
                                                         Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- Borde de overlay -->
        <Border x:Name="OverlayBorde"
                Grid.ColumnSpan="2"
                BorderBrush="#8080A0"
                BorderThickness="8"
                CornerRadius="20"
                Visibility="Collapsed"
                Background="Transparent"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
    </Grid>
</Window>