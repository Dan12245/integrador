<Window x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consumo Reducido de Agua (C.R.A)"
        WindowStartupLocation="CenterScreen"
        Background="#FFB2CFE6"
        MinWidth="400"
        MinHeight="300"
        Icon="/Images/Logo.png"
        Loaded="Window_Loaded">

    <Grid x:Name="RootContainer">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFB2CFE6" Offset="0.436"/>
                <GradientStop Color="White" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Contenedor con ViewBox para responsividad automática -->
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <Grid x:Name="ContentContainer" Width="800" Height="450">

                <!-- Tu contenido original -->
                <Grid x:Name="Login_Window" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="79*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="LogoInicio"
                           Source="/Images/Logo.png"
                           Width="250"
                           RenderTransformOrigin="0.5,0.5"
                           Opacity="0" OpacityMask="Black" Margin="275,0,265,0">
                        <Image.RenderTransform>
                            <TranslateTransform Y="100"/>
                        </Image.RenderTransform>
                    </Image>

                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Grid.Loaded">
                            <BeginStoryboard>
                                <Storyboard x:Name="LogoAnimacion" Completed="LogoAnimacion_Completed">
                                    <!-- Entrada -->
                                    <DoubleAnimation Storyboard.TargetName="LogoInicio"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1"
                                                     Duration="0:0:1"/>
                                    <DoubleAnimation Storyboard.TargetName="LogoInicio"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="100" To="0"
                                                     Duration="0:0:1"/>
                                    <!-- Salida -->
                                    <DoubleAnimation Storyboard.TargetName="LogoInicio"
                                                     Storyboard.TargetProperty="Opacity"
                                                     BeginTime="0:0:2"
                                                     From="1" To="0"
                                                     Duration="0:0:1"/>
                                    <DoubleAnimation Storyboard.TargetName="LogoInicio"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     BeginTime="0:0:2"
                                                     From="0" To="-50"
                                                     Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- Borde de overlay -->
        <Border x:Name="OverlayBorde"
                BorderBrush="#8080A0"
                BorderThickness="8"
                CornerRadius="20"
                Visibility="Collapsed"
                Background="Transparent"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
    </Grid>
</Window>