<Window x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View.Editors.ConsumoEditorWindow"
	 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	 xmlns:vm="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.ViewModels"
	 mc:Ignorable="d"
	 Title="Manage consumptions" Height="400" Width="560" MaxHeight="400" MaxWidth="560" WindowStartupLocation="CenterOwner">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header row: date + liters + add/update -->
		<StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top" HorizontalAlignment="Left">
			<TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<DatePicker x:Name="FechaPicker"
				SelectedDate="{Binding InputDate, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				DisplayDateStart="{Binding StartOfYear, Mode=OneWay}"
				DisplayDateEnd="{Binding Today, Mode=OneWay}"
				FirstDayOfWeek="Monday" Margin="6,0,0,0"/>
			<TextBlock Text="Liters:" VerticalAlignment="Center" Margin="12,0,6,0"/>
			<Grid Width="160" Height="28" VerticalAlignment="Center" Margin="0,0,6,0">
				<TextBox x:Name="ConsumoTextBox"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Center"
					Padding="6,2,6,2"
					PreviewTextInput="ConsumoTextBox_PreviewTextInput"
					DataObject.Pasting="ConsumoTextBox_Pasting"/>
				<TextBlock Text=" e.g.120.34"
					Foreground="Gray"
					VerticalAlignment="Center"
					HorizontalAlignment="Left"
					IsHitTestVisible="False">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Visibility" Value="Collapsed"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding Text, ElementName=ConsumoTextBox}" Value="">
									<Setter Property="Visibility" Value="Visible"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</Grid>
			<Button Content="Add/Update" Click="AddOrUpdate_Click"/>
		</StackPanel>

		<!-- Grid with two columns only -->
		<DataGrid x:Name="ConsumosGrid" Grid.Row="1"
			ItemsSource="{Binding Items}"
			SelectedItem="{Binding SelectedEntry, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
			AutoGenerateColumns="False"
			CanUserAddRows="False"
			HeadersVisibility="Column"
			ColumnWidth="*"
			SelectionChanged="DataGrid_SelectionChanged"
			PreviewMouseLeftButtonDown="ConsumosGrid_PreviewMouseLeftButtonDown">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Date" Binding="{Binding Day, StringFormat=d}" IsReadOnly="True"/>
				<DataGridTextColumn Header="Consumption (L)" Binding="{Binding Consumption, StringFormat=F2}"/>
			</DataGrid.Columns>
		</DataGrid>

		<!-- Footer buttons -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Height="30">
			<Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" IsEnabled="False" Width="50" Margin="0,0,20,0"/>
			<Button Content="Close" Click="Close_Click" Width="50"/>
		</StackPanel>
	</Grid>
</Window>
