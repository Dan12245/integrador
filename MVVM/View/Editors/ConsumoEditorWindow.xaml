<Window x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View.Editors.ConsumoEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:vm="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.ViewModels"
 mc:Ignorable="d"
 Title="Editar consumo" Height="400" Width="560" WindowStartupLocation="CenterOwner">
 <Grid Margin="10">
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="*"/>
 <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

 <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top" HorizontalAlignment="Left">
 <TextBlock Text="Fecha:" VerticalAlignment="Center" Margin="0,0,6,0"/>
 <DatePicker x:Name="FechaPicker"
 SelectedDate="{Binding InputDate, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
 DisplayDateStart="{Binding StartOfYear, Mode=OneWay}"
 DisplayDateEnd="{Binding Today, Mode=OneWay}"
 FirstDayOfWeek="Monday" Margin="6,0,0,0"/>
 <TextBlock Text="Litros:" VerticalAlignment="Center" Margin="12,0,6,0"/>
 <Grid Width="160" Height="28" VerticalAlignment="Center" Margin="0,0,6,0">
 <TextBox x:Name="ConsumoTextBox"
 HorizontalAlignment="Stretch"
 VerticalAlignment="Center"
 Padding="6,2,6,2"
 PreviewTextInput="ConsumoTextBox_PreviewTextInput"
 DataObject.Pasting="ConsumoTextBox_Pasting"/>
 <TextBlock Text="Introduce litros (p.ej.12.34)"
 Foreground="Gray"
 Margin="8,0,0,0"
 VerticalAlignment="Center"
 IsHitTestVisible="False">
 <TextBlock.Style>
 <Style TargetType="TextBlock">
 <Setter Property="Visibility" Value="Collapsed"/>
 <Style.Triggers>
 <DataTrigger Binding="{Binding Text, ElementName=ConsumoTextBox}" Value="">
 <Setter Property="Visibility" Value="Visible"/>
 </DataTrigger>
 </Style.Triggers>
 </Style>
 </TextBlock.Style>
 </TextBlock>
 </Grid>
 <Button Content="Agregar/Actualizar" Click="AddOrUpdate_Click"/>
 </StackPanel>

 <DataGrid x:Name="ConsumosGrid" Grid.Row="1"
 ItemsSource="{Binding Items}"
 SelectedItem="{Binding SelectedEntry, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
 AutoGenerateColumns="False"
 CanUserAddRows="False"
 HeadersVisibility="Column"
 ColumnWidth="*"
 SelectionChanged="DataGrid_SelectionChanged"
 PreviewMouseLeftButtonDown="ConsumosGrid_PreviewMouseLeftButtonDown">
 <DataGrid.Columns>
 <DataGridTextColumn Header="Fecha" Binding="{Binding Day, StringFormat=d}" IsReadOnly="True"/>
 <DataGridTextColumn Header="Consumo (L)" Binding="{Binding Consumption}"/>
 </DataGrid.Columns>
 </DataGrid>

 <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
 <Button x:Name="DeleteButton" Content="Eliminar" Click="Delete_Click" Margin="0,0,8,0" IsEnabled="False"/>
 <Button Content="Cerrar" Click="Close_Click"/>
 </StackPanel>
 </Grid>
</Window>
