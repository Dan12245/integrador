<Application x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModel="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.ViewModel"
             xmlns:view="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo.MVVM.View">
    <Application.Resources>
        <DataTemplate DataType="{x:Type viewModel:InicioViewModel}">
            <view:Inicio/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ConfiguracionViewModel}">
            <view:Configuracion/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:UsuarioViewModel}">
            <view:Usuario/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ReporteViewModel}">
            <view:Reporte/>
        </DataTemplate>
        <Style TargetType="FrameworkElement">
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style TargetType="TextElement">
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
    </Application.Resources>
</Application>