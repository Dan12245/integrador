<UserControl x:Class="C.R.A_Consumo_reducido_de_agua.Preguntas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:C.R.A_Consumo_reducido_de_agua"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="Login_Window" Background="#FFB2CFE6" Height="434" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="Boton_Register" Content="Iniciar" Click="Boton_Register_Click" HorizontalAlignment="Center" Margin="0,331,0,0" VerticalAlignment="Top" BorderBrush="#FF7385E3" FontSize="36" Width="442" Height="54" RenderTransformOrigin="0,0">

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FF4F49EC" Opacity="1"/>
                </Button.Background>
            </Button>
            <Label Content="Preguntas preguntosamente preguntosas" HorizontalAlignment="Center" Margin="0,143,0,0" VerticalAlignment="Top" FontSize="48"/>

        </Grid>
    </Viewbox>
</UserControl>
