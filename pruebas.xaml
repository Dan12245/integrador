<UserControl x:Class="Consumo_Reducido_de_Agua_ahora_si_definitivo.pruebas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Consumo_Reducido_de_Agua_ahora_si_definitivo"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid x:Name="RootContainer">
        <Grid.LayoutTransform>
            <!-- 🔸 AQUÍ definimos el nombre RootScale -->
            <ScaleTransform x:Name="RootScale"/>
        </Grid.LayoutTransform>

        <Viewbox x:Name="Escalador" Stretch="Uniform">
            <Grid Width="757" Height="225" Background="#FFA02F2F">
                <!-- Contenido -->
            </Grid>
        </Viewbox>

        <!-- Overlay de bordes -->
        <Border x:Name="OverlayBorde"
            BorderBrush="#FF691919"
            BorderThickness="100"
            CornerRadius="20"
            Visibility="Collapsed"
            Background="#40581414"/>
    </Grid>
</UserControl>
