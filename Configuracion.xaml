<UserControl x:Class="C.R.A_Consumo_reducido_de_agua.Configuracion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:C.R.A_Consumo_reducido_de_agua"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF04023E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#FF7385E3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="15">
                            <!-- 🔸 Redondeo de esquinas -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7385E3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="Login_Window" Background="#FFB2CEF6" Height="434" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Margin="-692,40,850,26" Source="Images/Captura de pantalla 2025-10-10 073526.png" Stretch="Fill"/>
            <Rectangle Stroke="#FF5881E8" Margin="98,0,0,351" Fill="#FF5881E8"/>
            <Rectangle HorizontalAlignment="Left" Height="434" Stroke="#FF394D7E" VerticalAlignment="Center" Width="98" Fill="#FF394D7E"/>
            <Button x:Name="Boton_Configuracion" Content="" Click="Boton_ir_a_Inicio" HorizontalAlignment="Left" Margin="20,80,0,0" VerticalAlignment="Top" BorderBrush="#FF7385E3" FontSize="36" Width="58" Height="56" RenderTransformOrigin="0,0" Cursor="Hand">

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FFBBD3F8" Opacity="1"/>
                </Button.Background>
            </Button>
            <Button x:Name="Boton_Reportar" Content="" Click="Boton_Reporte" HorizontalAlignment="Left" Margin="20,368,0,0" VerticalAlignment="Top" BorderBrush="#FF7385E3" FontSize="36" Width="58" Height="56" RenderTransformOrigin="0,0" Cursor="Hand">

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FFBBD3F8" Opacity="1"/>
                </Button.Background>
            </Button>
            <Image Margin="12,4,714,365" Source="Images/Logo.png" Height="65"/>
            <Button x:Name="Boton_Usuario" Content="" Click="Boton_Usuario_Invitados" HorizontalAlignment="Left" Margin="20,274,0,0" VerticalAlignment="Top" BorderBrush="#FF7385E3" FontSize="36" Width="58" Height="56" RenderTransformOrigin="0,0" Cursor="Hand">

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FFBBD3F8" Opacity="1"/>
                </Button.Background>
            </Button>
            <Button x:Name="Boton_Menu" Content="" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#FF303C73" FontSize="36" Width="58" Height="56" RenderTransformOrigin="0,0" Margin="49,163,0,0" BorderThickness="100">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="44.78"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FFBBD3F8" Opacity="1"/>
                </Button.Background>
            </Button>
            <Image Margin="32,378,734,20" Source="Images/Reportar.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Image Margin="30,284,730,114" Source="Images/Usuario e invitados.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Image Margin="29,183,729,211" Source="Images/Configuracion.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Image Margin="26,90,726,307" Source="Images/Menu Principal seleccionado.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Image Margin="109,21,332,365" Source="Images/Configuracion texto.png" Stretch="Fill"/>
            <Label Content="Tamaño de texto" HorizontalAlignment="Left" Margin="117,100,0,0" VerticalAlignment="Top" FontFamily="Yu Gothic UI Semibold" FontSize="20"/>
            <Label Content="Idioma" HorizontalAlignment="Left" Margin="117,175,0,0" VerticalAlignment="Top" FontFamily="Yu Gothic UI Semibold" FontSize="20"/>
            <Label Content="Talkback" HorizontalAlignment="Left" Margin="117,261,0,0" VerticalAlignment="Top" FontSize="20" FontFamily="Yu Gothic UI Semibold"/>
            <Label Content="Rendimiento" HorizontalAlignment="Left" Margin="470,102,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.061,-0.405" FontSize="20" FontFamily="Yu Gothic UI Semibold"/>
            <ComboBox x:Name="Tamaño" HorizontalAlignment="Left" Margin="122,133,0,0" VerticalAlignment="Top" Width="278" Height="33"/>
            <ComboBox x:Name="Talkback" HorizontalAlignment="Left" Margin="122,292,0,0" VerticalAlignment="Top" Width="278" Height="33"/>
            <ComboBox x:Name="Idioma" HorizontalAlignment="Left" Margin="122,208,0,0" VerticalAlignment="Top" Width="278" Height="33"/>
            <ComboBox x:Name="Rendimiento" HorizontalAlignment="Left" Margin="476,134,0,0" VerticalAlignment="Top" Width="278" Height="33"/>
            <Button Content="Cerrar sesion" Click="Boton_Cerrar_Sesion" HorizontalAlignment="Left" Margin="496,282,0,0" VerticalAlignment="Top"  Height="54" Width="248"/>
            <Button Content="Descartar" HorizontalAlignment="Left" Margin="137,369,0,0" VerticalAlignment="Top" Click="Button_Click" Height="54" Width="297" Background="#FFFFBEBE" Foreground="#FF752D2D" BorderBrush="#FFFFBEBE"/>
            <Button Content="Aplicar" HorizontalAlignment="Left" Margin="467,369,0,0" VerticalAlignment="Top" Click="Button_Click" Height="54" Width="297" Background="#FF96FFD7" Foreground="#FF276F54" BorderBrush="#FF96FFD7"/>
            <Button Margin="730,10,10,370" Cursor="Hand" Click="Config_Help_Click" Height="55" Width="55">
                <Button.BorderBrush>
                    <SolidColorBrush Color="#FF7385E3" Opacity="0"/>
                </Button.BorderBrush>
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Help.png"/>
                </Button.Background>
            </Button>
            <Button Content="Eliminar Cuenta" Click="Boton_Eliminar_Usuario" HorizontalAlignment="Left" Margin="496,208,0,0" VerticalAlignment="Top"  Height="54" Width="248"/>
        </Grid>
    </Viewbox>
</UserControl>
