<UserControl x:Class="Prueba.View.UserControls.MenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Prueba.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">
    
    <Grid Grid.Row="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="File" FontSize="15">
                <MenuItem Header="New" FontSize="14"/>
                <MenuItem Header="Open" FontSize="14"/>
                <MenuItem Header="Save" FontSize="14"/>
                <Separator/>
                <MenuItem Header="Exit" FontSize="14"/>
            </MenuItem>
            <MenuItem Header="Edit" FontSize="15">
            </MenuItem>
        </Menu>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Button Name="btnBuscar" Width="50" Margin="4"/>
            <TextBox Name="tbBuscar" Width="150" Grid.Column="1" Margin="4" TextChanged="tbBuscar_TextChanged"/>

        </Grid>
    </Grid>
</UserControl>
