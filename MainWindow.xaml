<Window x:Name="Login" x:Class="C.R.A_Consumo_reducido_de_agua.MainWindow"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:C.R.A_Consumo_reducido_de_agua"
        mc:Ignorable="d"
        Title="Consumo Reducido de Agua (C.R.A)" Height="450" Width="800" Background="#FFB2CFE6" Icon="/logo programa.png">

    <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="Login_Window" Background="#FFB2CFE6" Height="434" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="Boton_Register" Content="Iniciar" Click="Boton_Register_Click" HorizontalAlignment="Center" Margin="0,331,0,0" VerticalAlignment="Top" BorderBrush="#FF7385E3" FontSize="36" Width="442" Height="54" RenderTransformOrigin="0,0">

                <Button.Foreground>
                    <SolidColorBrush Color="White" Opacity="0.4"/>
                </Button.Foreground>
                <Button.Background>
                    <SolidColorBrush Color="#FF4F49EC" Opacity="1"/>
                </Button.Background>
            </Button>
            <Label Content="Consumo Reducido de Agua" HorizontalAlignment="Center" Margin="0,143,0,0" VerticalAlignment="Top" FontSize="48"/>

        </Grid>
    </Viewbox>

</Window>
