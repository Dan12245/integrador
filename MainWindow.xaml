<Window x:Name="Ventana_de_gráficas" x:Class="CRA.MainWindow"
<Window x:Name="Login" x:Class="C.R.A_Consumo_reducido_de_agua.MainWindow"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:CRA.ViewModels"
        Title="Ejemplo pal proyecto" Width="850" Height="700" Icon="/carpincho.png" WindowStartupLocation="CenterOwner">
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:C.R.A_Consumo_reducido_de_agua"
        mc:Ignorable="d"
        Title="Consumo Reducido de Agua (C.R.A)" Height="450" Width="800" Background="#FFB2CFE6" Icon="Images/logo programa.png">
    
    <!-- Recursos -->
    <Window.Resources>
    <Viewbox Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="Login_Window" Height="434" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFB2CFE6" Offset="0.436"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
        
        <vm:PeriodToCheckedConverter x:Key="PeriodToCheckedConverter"/>
            <Image x:Name="LogoInicio"
           Source="Images/Logo.png"
           Width="250"
           RenderTransformOrigin="0.5,0.5"
           Opacity="0" OpacityMask="Black">
                <Image.RenderTransform>
                    <TranslateTransform Y="100"/>
                </Image.RenderTransform>
            </Image>
        
        <Style TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".1*"/>
            <RowDefinition Height=".9*"/>
        </Grid.RowDefinitions>

        <!-- Añade los botones para seleccionar el periodo en el que se muestra los datos -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Button Command="{Binding GoToPage1Command}" >Day</Button>
            <Button Command="{Binding GoToPage2Command}">Week</Button>
            <Button Command="{Binding GoToPage3Command}">Month</Button>
            <Button Command="{Binding SeeAllCommand}">Year</Button>
        </StackPanel>
            <Grid.Triggers>
                <!-- Animación de entrada y salida -->
                <EventTrigger RoutedEvent="Grid.Loaded">
                    <BeginStoryboard>
                        <Storyboard x:Name="LogoAnimacion" Completed="LogoAnimacion_Completed">
                            <!-- Entrada: sube y aparece -->
                            <DoubleAnimation Storyboard.TargetName="LogoInicio"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="LogoInicio"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="100" To="0"
                                     Duration="0:0:1"/>

        <lvc:CartesianChart Grid.Row="1" ZoomMode="X" Series="{Binding Values}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                            Width="800" Height="600"/>
                            <!-- Espera 2 segundos -->
                            <DoubleAnimation Storyboard.TargetName="LogoInicio"
                                     Storyboard.TargetProperty="Opacity"
                                     BeginTime="0:0:2"
                                     From="1" To="0"
                                     Duration="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="LogoInicio"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     BeginTime="0:0:2"
                                     From="0" To="-50"
                                     Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
    </Grid>
    </Viewbox>

</Window>